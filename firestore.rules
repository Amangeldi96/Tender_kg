rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /companies/{uid} {
      // Directory for login picker: company name and email only, no secrets.
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email'])
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /tenders/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == id;
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == id;
    }
  }
}
