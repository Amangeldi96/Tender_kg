rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Профиль ар бир аккаунтка гана таандык; жалпы тендерлерден өзүнчө.
    match /publicCompanies/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /companies/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Орток тендер базасы: бардык кирген аккаунттар бир эле коллекцияны көрөт.
    // Колдонмодогу аткаруучулар — өзүнчө Firebase Auth UID эмес, executor аты.
    match /tenders/{recordId} {
      allow read: if signedIn();

      // recordId Firestore документинин ачкычы, id — тендердин номери.
      // Бир номерде бир нече лот болгондуктан алар бирдей болушу шарт эмес.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recordId == recordId;

      // Биринчи кошкон адам жана Firestore документ ачкычы өзгөрбөйт.
      allow update: if signedIn()
        && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
        && request.resource.data.get('recordId', null) == resource.data.get('recordId', null);

      // Бул ички долбоордо бардык кирген аккаунттар аткаруучулардын
      // тендерлерин башкара алат. UI'дагы чектөөлөр сервердик роль эмес.
      allow delete: if signedIn();
    }
  }
}
